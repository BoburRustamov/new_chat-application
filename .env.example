# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# Copy this file to .env and fill in your values
#
#   cp .env.example .env
#
# NEVER commit .env to git! It contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# For local development with Docker:
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# For production (Neon.tech free database):
# Get this from neon.tech dashboard after creating a project
# DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# -----------------------------------------------------------------------------
# JWT (JSON Web Token) - For authentication
# -----------------------------------------------------------------------------
# Generate a random 32+ character string
# You can use: openssl rand -base64 32
JWT_SECRET=YourSuperSecretKeyThatIsAtLeast32CharactersLong!

# -----------------------------------------------------------------------------
# ADMIN CREDENTIALS
# -----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# -----------------------------------------------------------------------------
# FRONTEND URLs (for building the frontend)
# -----------------------------------------------------------------------------
# Local development:
VITE_API_URL=http://localhost:5004/api
VITE_HUB_URL=http://localhost:5004/hubs/chat

# Production (update these after deploying backend):
# VITE_API_URL=https://your-backend.onrender.com/api
# VITE_HUB_URL=https://your-backend.onrender.com/hubs/chat
